{
  "name": "openslot-monorepo",
  "private": true,
  "type": "module",
  "description": "OpenSlot: calendar and booking scheduling with a framework-neutral core and React and Svelte adapters.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* run build",
    "check": "pnpm -r run check",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @openslot/svelte run test:e2e",
    "demo": "pnpm --filter @openslot/svelte run demo",
    "demo:build": "pnpm --filter @openslot/svelte run demo:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.57.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
