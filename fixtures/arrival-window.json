{
  "$schema": "./fixture.schema.json",
  "name": "arrival-window",
  "description": "Two technicians in Chicago, open 8:00-17:00, a 90-minute job. As 2-hour arrival windows, each window holds the window plus the job (the latest arrival still finishes), and a window that would end after closing is not offered. As exact times on a 30-minute grid, the same data gives different slots. t1 is busy 10:00-12:00.",
  "timeZone": "America/Chicago",
  "now": "2030-06-10T00:00:00.000Z",
  "hours": { "weekly": { "0": null, "6": null }, "default": { "open": 480, "close": 1020 } },
  "resources": [
    { "id": "t1", "title": "Tech 1", "compatKey": "hvac", "order": 1 },
    { "id": "t2", "title": "Tech 2", "compatKey": "hvac", "order": 2 }
  ],
  "events": [
    {
      "id": "j1",
      "title": "Job",
      "resourceId": "t1",
      "start": "2030-06-11T15:00:00.000Z",
      "end": "2030-06-11T17:00:00.000Z",
      "compatKey": "hvac"
    }
  ],
  "rules": { "durationMin": 90, "compatKey": "hvac" },
  "cases": [
    {
      "name": "arrival windows",
      "fn": "generateSlots",
      "input": { "from": "2030-06-11", "arrivalWindowMin": 120 },
      "expect": [
        {
          "start": "2030-06-11T13:00:00.000Z",
          "end": "2030-06-11T16:30:00.000Z",
          "arrival": { "from": "2030-06-11T13:00:00.000Z", "to": "2030-06-11T15:00:00.000Z" },
          "resourceIds": ["t2"]
        },
        {
          "start": "2030-06-11T15:00:00.000Z",
          "end": "2030-06-11T18:30:00.000Z",
          "arrival": { "from": "2030-06-11T15:00:00.000Z", "to": "2030-06-11T17:00:00.000Z" },
          "resourceIds": ["t2"]
        },
        {
          "start": "2030-06-11T17:00:00.000Z",
          "end": "2030-06-11T20:30:00.000Z",
          "arrival": { "from": "2030-06-11T17:00:00.000Z", "to": "2030-06-11T19:00:00.000Z" },
          "resourceIds": ["t1", "t2"]
        }
      ]
    },
    {
      "name": "exact times",
      "fn": "generateSlots",
      "input": { "from": "2030-06-11", "stepMin": 30, "limit": 3 },
      "expect": [
        { "start": "2030-06-11T13:00:00.000Z", "end": "2030-06-11T14:30:00.000Z", "resourceIds": ["t1", "t2"] },
        { "start": "2030-06-11T13:30:00.000Z", "end": "2030-06-11T15:00:00.000Z", "resourceIds": ["t1", "t2"] },
        { "start": "2030-06-11T14:00:00.000Z", "end": "2030-06-11T15:30:00.000Z", "resourceIds": ["t2"] }
      ]
    },
    { "name": "weekends are closed", "fn": "generateSlots", "input": { "from": "2030-06-15", "to": "2030-06-16" }, "expect": [] }
  ]
}
