{
  "$schema": "./fixture.schema.json",
  "name": "dst-day",
  "description": "Slot generation across both New York DST changes. Spring forward: 2:00-3:00 does not exist, every real start is offered once and every slot lasts 60 real minutes. Fall back: 1:00-2:00 happens twice and both hours are offered.",
  "timeZone": "America/New_York",
  "now": "2030-01-01T00:00:00.000Z",
  "resources": [{ "id": "r1", "title": "Resource 1" }],
  "events": [],
  "cases": [
    {
      "name": "spring forward, 1:00-5:00 wall clock, 30-minute grid",
      "fn": "generateSlots",
      "input": { "hours": { "default": { "open": 60, "close": 300 } }, "from": "2030-03-10", "durationMin": 60, "stepMin": 30 },
      "expect": [
        { "start": "2030-03-10T06:00:00.000Z", "end": "2030-03-10T07:00:00.000Z", "resourceIds": ["r1"] },
        { "start": "2030-03-10T06:30:00.000Z", "end": "2030-03-10T07:30:00.000Z", "resourceIds": ["r1"] },
        { "start": "2030-03-10T07:00:00.000Z", "end": "2030-03-10T08:00:00.000Z", "resourceIds": ["r1"] },
        { "start": "2030-03-10T07:30:00.000Z", "end": "2030-03-10T08:30:00.000Z", "resourceIds": ["r1"] },
        { "start": "2030-03-10T08:00:00.000Z", "end": "2030-03-10T09:00:00.000Z", "resourceIds": ["r1"] }
      ]
    },
    {
      "name": "fall back, 1:00-4:00 wall clock, hourly grid: the repeated hour is offered twice",
      "fn": "generateSlots",
      "input": { "hours": { "default": { "open": 60, "close": 240 } }, "from": "2030-11-03", "durationMin": 60, "stepMin": 60 },
      "expect": [
        { "start": "2030-11-03T05:00:00.000Z", "end": "2030-11-03T06:00:00.000Z", "resourceIds": ["r1"] },
        { "start": "2030-11-03T06:00:00.000Z", "end": "2030-11-03T07:00:00.000Z", "resourceIds": ["r1"] },
        { "start": "2030-11-03T07:00:00.000Z", "end": "2030-11-03T08:00:00.000Z", "resourceIds": ["r1"] },
        { "start": "2030-11-03T08:00:00.000Z", "end": "2030-11-03T09:00:00.000Z", "resourceIds": ["r1"] }
      ]
    },
    {
      "name": "a wall-clock time skipped by spring forward rolls forward",
      "fn": "zonedToIso",
      "input": { "date": "2030-03-10", "minutes": 150 },
      "expect": "2030-03-10T07:30:00.000Z"
    }
  ]
}
